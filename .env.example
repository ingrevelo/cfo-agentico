# Copiar a .env y completar. Nunca subir el .env al repositorio.

# Adaptador de Belo: mock (por defecto) o live
BELO_ADAPTER=mock

# Servidor MCP: el MCP simulado del equipo (p. ej. http://localhost:8001/mcp)
# mientras no haya acceso, o el MCP V1 de Belo cuando llegue el kit
BELO_MCP_URL=
BELO_BELOTAG=

# Proveedor del LLM (a definir por el equipo)
LLM_PROVIDER=
LLM_API_KEY=

# Base de datos local
DATABASE_URL=sqlite:///./cfo_agentico.db
