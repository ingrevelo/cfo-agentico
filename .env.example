# Copiar a .env y completar. Nunca subir el .env al repositorio.

# Adaptador de Belo: mock (por defecto) o live
BELO_ADAPTER=mock

# Servidor MCP: el MCP simulado del equipo (p. ej. http://localhost:8001/mcp)
# o el MCP de Belo: https://b2b.belo.app/mcp (OAuth; los tokens quedan en
# ~/.cfo-agentico/, nunca aquí)
BELO_MCP_URL=

# LLM (backend/app/agent/llm.py). Sin clave, la app usa textos de plantilla.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODELO=claude-opus-5-5
# LLM_DESACTIVADO=1 fuerza las plantillas (útil en tests y si falla la red en la demo)
LLM_DESACTIVADO=

# Base de datos local
DATABASE_URL=sqlite:///./cfo_agentico.db
